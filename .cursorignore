# Cursor ignore file
# Files that should be hidden in Cursor file explorer

# Dependencies
node_modules/

# Build outputs
.next/
out/
build/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo
next-env.d.ts


.env.local
# deprecated: Note: .env.local is NOT ignored here so it's visible in Cursor
# It's still in .gitignore for security (which is correct)
